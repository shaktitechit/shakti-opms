        proxy_pass http://medica_product_service;
    }
}

server {
    listen 80;
    server_name api-parties.medicaent.in;
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
    location / {
        include /etc/nginx/snippets/proxy-params.conf;
        proxy_pass http://medica_party_service;
    }
}

server {
    listen 80;
    server_name api-plans.medicaent.in;
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
    location ~ ^/api/notifications/stream {
        include /etc/nginx/snippets/proxy-sse.conf;
        proxy_pass http://medica_work_planner_backend;
    }
    location / {
        include /etc/nginx/snippets/proxy-params.conf;
        proxy_pass http://medica_work_planner_backend;
    }
}

server {
    listen 80;
    server_name api-leads.medicaent.in;
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
    location ~ ^/api/notifications/stream {
