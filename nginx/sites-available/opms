# =============================================================================
# API / backend services
# =============================================================================

# OPMS API
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api-opms.spspl.com;

    ssl_certificate     /etc/letsencrypt/live/api-opms.spspl.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api-opms.spspl.com/privkey.pem;
    include /etc/nginx/snippets/ssl-params.conf;

    client_max_body_size 50m;

    location / {
        include /etc/nginx/snippets/proxy-params.conf;
        proxy_pass http://opms_backend;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}

# Auth
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name auth.spspl.com;

    ssl_certificate     /etc/letsencrypt/live/auth.spspl.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/auth.spspl.com/privkey.pem;
    include /etc/nginx/snippets/ssl-params.conf;

    client_max_body_size 50m;

    # Auth may proxy notification SSE under /api/notifications
    location ~ ^/api/notifications/stream {
        include /etc/nginx/snippets/proxy-sse.conf;
        proxy_pass http://auth_service;
    }

    location / {
        include /etc/nginx/snippets/proxy-params.conf;
        proxy_pass http://auth_service;
        proxy_read_timeout 120s;
    }
}

