# =============================================================================
# APIs
# =============================================================================

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.medicaent.in;
    include /etc/nginx/snippets/medica-ssl.conf;
    client_max_body_size 50m;

    location / {
        include /etc/nginx/snippets/proxy-params.conf;
        proxy_pass http://medica_opms_backend;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name auth.medicaent.in;
    include /etc/nginx/snippets/medica-ssl.conf;
    client_max_body_size 50m;
    access_log /var/log/nginx/medica-auth.access.log opms_main;

    # Requires http{} include of snippets/logging.conf (log_format + limit_req_zone)
    include /etc/nginx/snippets/medica-auth-rate-limit.conf;

    location ~ ^/api/notifications/stream {
        include /etc/nginx/snippets/proxy-sse.conf;
        proxy_pass http://medica_auth_service;
    }

    location / {
        include /etc/nginx/snippets/proxy-params.conf;
        proxy_pass http://medica_auth_service;
        proxy_read_timeout 120s;
    }
}

