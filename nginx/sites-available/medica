# =============================================================================
# Medica — nginx sites-available (HTTPS)
#
# DO NOT enable this file until certificates exist:
#   ls /etc/letsencrypt/live/opms.medicaent.in/fullchain.pem
#
# Order of operations:
#   1) Keep medica.http-bootstrap enabled (HTTP proxies + ACME webroot)
#   2) Point DNS A/AAAA for all hosts at this server
#   3) Issue multi-SAN or wildcard cert (see nginx/snippets/medica-ssl.conf)
#   4) Then:
#        sudo cp nginx/snippets/* /etc/nginx/snippets/
#        sudo cp nginx/sites-available/medica /etc/nginx/sites-available/medica
#        sudo ln -sfn /etc/nginx/sites-available/medica /etc/nginx/sites-enabled/medica
#        sudo nginx -t && sudo systemctl reload nginx
#
# listen is "ssl" only (no http2 flag) to avoid
# "protocol options redefined" warnings with other sites on :443.
# =============================================================================

upstream opms_backend          { server 127.0.0.1:5001; keepalive 32; }
upstream opms_frontend         { server 127.0.0.1:5002; keepalive 16; }
upstream auth_service          { server 127.0.0.1:5003; keepalive 32; }
upstream user_manager_frontend { server 127.0.0.1:5004; keepalive 16; }
upstream product_service       { server 127.0.0.1:5005; keepalive 32; }
upstream party_service         { server 127.0.0.1:5006; keepalive 32; }
upstream work_planner_backend  { server 127.0.0.1:5007; keepalive 32; }
upstream work_planner_frontend { server 127.0.0.1:5008; keepalive 16; }
upstream lead_manager_backend  { server 127.0.0.1:5009; keepalive 32; }
upstream lead_manager_frontend { server 127.0.0.1:5010; keepalive 16; }
upstream message_service       { server 127.0.0.1:5011; keepalive 32; }
upstream notification_service  { server 127.0.0.1:5012; keepalive 32; }
upstream app_frontend          { server 127.0.0.1:5013; keepalive 16; }

# -----------------------------------------------------------------------------
# HTTP → HTTPS (+ ACME challenge)
# -----------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name
        opms.medicaent.in
        app.medicaent.in
        users.medicaent.in
        plans.medicaent.in
        leads.medicaent.in
        api.medicaent.in
        auth.medicaent.in
        api-products.medicaent.in
        api-parties.medicaent.in
        api-plans.medicaent.in
        api-leads.medicaent.in
        api-message.medicaent.in;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# =============================================================================
# Frontends
# =============================================================================

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name app.medicaent.in;
    include /etc/nginx/snippets/medica-ssl.conf;
    client_max_body_size 50m;

    location / {
        include /etc/nginx/snippets/proxy-upgrade.conf;
        proxy_pass http://app_frontend;
    }
}

