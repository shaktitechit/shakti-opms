# =============================================================================
# OPMS Docker environment (EXAMPLE)
# =============================================================================
# Used by:
#   docker compose --env-file .env.docker up --build
#   docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.dev.yml up --build
#
# Copy to .env.docker and fill in secrets. Do not commit .env.docker.
# Public hostnames must match nginx/sites-available/opms.
# =============================================================================

# -----------------------------------------------------------------------------
# Core / security
# -----------------------------------------------------------------------------
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Break-glass login for any user email (leave empty in production)
MASTER_PASSWORD=
JSON_BODY_LIMIT=50mb

# -----------------------------------------------------------------------------
# Database & cache
# -----------------------------------------------------------------------------
# Host Mongo (reachable from containers via host.docker.internal)
MONGO_URI=mongodb+srv://USER:PASS@CLUSTER/shakti-opms
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/shakti-opms
# Prefer IPv4 for Atlas / some host Mongo setups
MONGODB_LOOKUP_FAMILY=4
REDIS_PORT=7014
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Service ports (host ↔ container)
# -----------------------------------------------------------------------------
OPMS_BACKEND_PORT=7001
AUTH_SERVICE_PORT=7003
PRODUCT_SERVICE_PORT=7005
PARTY_SERVICE_PORT=7006
WORK_PLANNER_BACKEND_PORT=7007
WORK_PLANNER_FRONTEND_PORT=7008
LEAD_MANAGER_BACKEND_PORT=7009
LEAD_MANAGER_FRONTEND_PORT=7010
MESSAGE_SERVICE_PORT=7011
NOTIFICATION_SERVICE_PORT=7012
OPMS_FRONTEND_PORT=7002
USER_MANAGER_FRONTEND_PORT=7004
APP_FRONTEND_PORT=7013

# -----------------------------------------------------------------------------
# Internal Docker network URLs (service-to-service on the compose network)
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://auth-service:7003
PRODUCT_SERVICE_URL=http://product-service:7005
PARTY_SERVICE_URL=http://party-service:7006
WORK_PLANNER_SERVICE_URL=http://work-planner-backend:7007
LEAD_MANAGER_SERVICE_URL=http://lead-manager-backend:7009
MESSAGE_SERVICE_URL=http://message-service:7011
NOTIFICATION_SERVICE_URL=http://notification-service:7012

# -----------------------------------------------------------------------------
# Public URLs (browser / emails / webhooks — nginx TLS, no :ports)
# -----------------------------------------------------------------------------
API_PUBLIC_BASE_URL=https://api-opms.spspl.com
LEAD_MANAGER_PUBLIC_URL=https://leads.spspl.com
NEXT_PUBLIC_API_ORIGIN=https://api-opms.spspl.com
NEXT_PUBLIC_AUTH_SERVICE_URL=https://auth.spspl.com
NEXT_PUBLIC_AUTH_ORIGIN=https://auth.spspl.com
NEXT_PUBLIC_PRODUCT_SERVICE_URL=https://api-products.spspl.com
NEXT_PUBLIC_PARTY_SERVICE_URL=https://api-parties.spspl.com
NEXT_PUBLIC_WORK_PLANNER_SERVICE_URL=https://api-plans.spspl.com
NEXT_PUBLIC_LEAD_MANAGER_SERVICE_URL=https://api-leads.spspl.com
NEXT_PUBLIC_MESSAGE_SERVICE_URL=https://api-message.spspl.com
NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=https://notification.spspl.com
NEXT_PUBLIC_APP_URL=https://app.spspl.com
NEXT_PUBLIC_OPMS_URL=https://opms.spspl.com
NEXT_PUBLIC_USER_MANAGER_URL=https://users.spspl.com
NEXT_PUBLIC_WORK_PLANNER_URL=https://plans.spspl.com
NEXT_PUBLIC_LEAD_MANAGER_URL=https://leads.spspl.com

# Extra CORS origins (comma-separated frontend origins only)
CORS_ORIGINS=https://app.spspl.com,https://opms.spspl.com,https://users.spspl.com,https://plans.spspl.com,https://leads.spspl.com

# -----------------------------------------------------------------------------
# Company branding (fallback when CompanyInfo API is empty)
# Prefer configuring logo/name in User Manager → Company Information.
# -----------------------------------------------------------------------------
COMPANY_NAME=Shakti Powers
COMPANY_LOGO_URL=https://spspl.com/logo.png
NEXT_PUBLIC_COMPANY_NAME=Shakti Powers
NEXT_PUBLIC_COMPANY_LOGO_URL=https://spspl.com/logo.png
NEXT_PUBLIC_COMPANY_FAVICON_URL=https://spspl.com/favicon.ico

# -----------------------------------------------------------------------------
# Demo seed (first boot / seed scripts)
# -----------------------------------------------------------------------------
SEED_DATABASE=false
SEED_PASSWORD=change-me
SEED_CORE_USERS_ONLY=true
SEED_EXTRA_USERS=false

# -----------------------------------------------------------------------------
# Lead follow-up reminders
# -----------------------------------------------------------------------------
FOLLOWUP_REMINDER_ENABLED=true
FOLLOWUP_REMINDER_CRON=0 7 * * *
FOLLOWUP_REMINDER_TZ=Asia/Kolkata

# -----------------------------------------------------------------------------
# File management (optional; leave empty to skip external uploads)
# -----------------------------------------------------------------------------
FILE_MANAGEMENT_API_URL=
FILE_MANAGEMENT_API_KEY=

# -----------------------------------------------------------------------------
# SMTP (optional — used when Microsoft Graph is not configured / as fallback)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional role inboxes for order emails
ADMIN_EMAIL=
ACCOUNT_EMAIL=
FINANCE_EMAIL=
DUE_SHEET_EMAIL=

# -----------------------------------------------------------------------------
# Microsoft Graph (optional — preferred for outbound email when set)
# -----------------------------------------------------------------------------
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_SENDER_EMAIL=

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (optional)
# Template name must match Meta WhatsApp Manager exactly.
# -----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_ORDER_RECEIVED=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# -----------------------------------------------------------------------------
# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Public key must be exposed to frontends as NEXT_PUBLIC_VAPID_PUBLIC_KEY
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@spspl.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
