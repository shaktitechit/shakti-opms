# =============================================================================
# OPMS Docker environment (EXAMPLE — placeholders only)
# =============================================================================
# Used by:
#   docker compose --env-file .env.docker up --build
#   docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.dev.yml up --build
#
# Copy to .env.docker and fill in real secrets. Do not commit .env.docker.
# Public hostnames must match nginx/sites-available/opms.
# If this file ever contained real credentials, rotate them immediately.
# =============================================================================

# -----------------------------------------------------------------------------
# Core / security
# -----------------------------------------------------------------------------
NODE_ENV=production
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=8h
# Break-glass login for any user email — MUST be empty in production
MASTER_PASSWORD=
JSON_BODY_LIMIT=50mb

# -----------------------------------------------------------------------------
# Database & cache
# -----------------------------------------------------------------------------
# Host Mongo (reachable from containers via host.docker.internal) or Atlas URI
MONGO_URI=mongodb://user:password@host:27017/opms?authSource=admin
MONGODB_URI=mongodb://user:password@host:27017/opms?authSource=admin
# Prefer IPv4 for Atlas / some host Mongo setups
MONGODB_LOOKUP_FAMILY=4
# Redis: password required by compose. Compose builds REDIS_URL from REDIS_PASSWORD
# (do not rely on a bare redis://redis:6379 in env — it will be overridden).
REDIS_PASSWORD=replace-with-redis-password
REDIS_PORT=7014
# Optional documentation only — compose injects redis://:${REDIS_PASSWORD}@redis:6379
REDIS_URL=redis://:replace-with-redis-password@redis:6379

# -----------------------------------------------------------------------------
# Service ports (host ↔ container)
# message-service / notification-service are NOT published (Compose network only)
# -----------------------------------------------------------------------------
OPMS_BACKEND_PORT=7001
AUTH_SERVICE_PORT=7003
PRODUCT_SERVICE_PORT=7005
PARTY_SERVICE_PORT=7006
WORK_PLANNER_BACKEND_PORT=7007
WORK_PLANNER_FRONTEND_PORT=7008
LEAD_MANAGER_BACKEND_PORT=7009
LEAD_MANAGER_FRONTEND_PORT=7010
MESSAGE_SERVICE_PORT=7011
NOTIFICATION_SERVICE_PORT=7012
OPMS_FRONTEND_PORT=7002
USER_MANAGER_FRONTEND_PORT=7004
APP_FRONTEND_PORT=7013

# -----------------------------------------------------------------------------
# Internal Docker network URLs (service-to-service on the compose network)
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://auth-service:7003
PRODUCT_SERVICE_URL=http://product-service:7005
PARTY_SERVICE_URL=http://party-service:7006
WORK_PLANNER_SERVICE_URL=http://work-planner-backend:7007
LEAD_MANAGER_SERVICE_URL=http://lead-manager-backend:7009
MESSAGE_SERVICE_URL=http://message-service:7011
NOTIFICATION_SERVICE_URL=http://notification-service:7012

# -----------------------------------------------------------------------------
# Public URLs (browser / emails / webhooks — nginx TLS, no :ports)
# -----------------------------------------------------------------------------
API_PUBLIC_BASE_URL=https://api.example.com
LEAD_MANAGER_PUBLIC_URL=https://leads.example.com
# Login link in welcome emails (auth-service → app-frontend)
APP_LOGIN_URL=https://app.example.com
NEXT_PUBLIC_API_ORIGIN=https://api.example.com
NEXT_PUBLIC_AUTH_SERVICE_URL=https://auth.example.com
NEXT_PUBLIC_AUTH_ORIGIN=https://auth.example.com
NEXT_PUBLIC_PRODUCT_SERVICE_URL=https://api-products.example.com
NEXT_PUBLIC_PARTY_SERVICE_URL=https://api-parties.example.com
NEXT_PUBLIC_WORK_PLANNER_SERVICE_URL=https://api-plans.example.com
NEXT_PUBLIC_LEAD_MANAGER_SERVICE_URL=https://api-leads.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_OPMS_URL=https://opms.example.com
NEXT_PUBLIC_USER_MANAGER_URL=https://users.example.com
NEXT_PUBLIC_WORK_PLANNER_URL=https://plans.example.com
NEXT_PUBLIC_LEAD_MANAGER_URL=https://leads.example.com

# Extra CORS origins (comma-separated frontend origins only)
CORS_ORIGINS=https://app.example.com,https://opms.example.com,https://users.example.com,https://plans.example.com,https://leads.example.com

# -----------------------------------------------------------------------------
# Company branding (fallback when CompanyInfo API is empty)
# Prefer configuring logo/name in User Manager → Company Information.
# -----------------------------------------------------------------------------
COMPANY_NAME=Your Company
COMPANY_LOGO_URL=https://example.com/logo.png
NEXT_PUBLIC_COMPANY_NAME=Your Company
NEXT_PUBLIC_COMPANY_LOGO_URL=https://example.com/logo.png
NEXT_PUBLIC_COMPANY_FAVICON_URL=https://example.com/favicon.ico

# -----------------------------------------------------------------------------
# Demo seed (first boot / seed scripts)
# -----------------------------------------------------------------------------
SEED_DATABASE=false
SEED_PASSWORD=ChangeMe1a
SEED_CORE_USERS_ONLY=true
SEED_EXTRA_USERS=false

# -----------------------------------------------------------------------------
# Lead follow-up reminders
# -----------------------------------------------------------------------------
FOLLOWUP_REMINDER_ENABLED=true
FOLLOWUP_REMINDER_CRON=0 7 * * *
FOLLOWUP_REMINDER_TZ=Asia/Kolkata

# -----------------------------------------------------------------------------
# File management (optional; leave empty to skip external uploads)
# -----------------------------------------------------------------------------
FILE_MANAGEMENT_API_URL=
FILE_MANAGEMENT_API_KEY=

# -----------------------------------------------------------------------------
# Google Sheets webhooks (optional)
# -----------------------------------------------------------------------------
GOOGLE_SHEET_WEBHOOK_SECRET=replace-with-webhook-secret

# -----------------------------------------------------------------------------
# SMTP (optional — used when Microsoft Graph is not configured / as fallback)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional role inboxes for order emails
ADMIN_EMAIL=
ACCOUNT_EMAIL=
FINANCE_EMAIL=
DUE_SHEET_EMAIL=

# -----------------------------------------------------------------------------
# Microsoft Graph (optional — preferred for outbound email when set)
# -----------------------------------------------------------------------------
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_SENDER_EMAIL=

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (optional)
# Template name must match Meta WhatsApp Manager exactly.
# -----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_ORDER_RECEIVED=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# -----------------------------------------------------------------------------
# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Public key must be exposed to frontends as NEXT_PUBLIC_VAPID_PUBLIC_KEY
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
