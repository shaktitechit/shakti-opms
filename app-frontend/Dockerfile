FROM node:20-alpine AS builder

WORKDIR /app

ARG NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:5003
ARG NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=http://localhost:5012
ARG NEXT_PUBLIC_OPMS_URL=http://localhost:5002
ARG NEXT_PUBLIC_USER_MANAGER_URL=http://localhost:5004/dashboard
ARG NEXT_PUBLIC_WORK_PLANNER_URL=http://localhost:5008/dashboard
ARG NEXT_PUBLIC_LEAD_MANAGER_URL=http://localhost:5010/dashboard
ENV NEXT_PUBLIC_AUTH_SERVICE_URL=$NEXT_PUBLIC_AUTH_SERVICE_URL
ENV NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=$NEXT_PUBLIC_NOTIFICATION_SERVICE_URL
ENV NEXT_PUBLIC_OPMS_URL=$NEXT_PUBLIC_OPMS_URL
ENV NEXT_PUBLIC_USER_MANAGER_URL=$NEXT_PUBLIC_USER_MANAGER_URL
ENV NEXT_PUBLIC_WORK_PLANNER_URL=$NEXT_PUBLIC_WORK_PLANNER_URL
ENV NEXT_PUBLIC_LEAD_MANAGER_URL=$NEXT_PUBLIC_LEAD_MANAGER_URL

COPY package.json ./
RUN npm install

COPY . .
RUN npm run build

FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

ARG NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:5003
ARG NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=http://localhost:5012
ARG NEXT_PUBLIC_OPMS_URL=http://localhost:5002
ARG NEXT_PUBLIC_USER_MANAGER_URL=http://localhost:5004/dashboard
ARG NEXT_PUBLIC_WORK_PLANNER_URL=http://localhost:5008/dashboard
ARG NEXT_PUBLIC_LEAD_MANAGER_URL=http://localhost:5010/dashboard
ENV NEXT_PUBLIC_AUTH_SERVICE_URL=$NEXT_PUBLIC_AUTH_SERVICE_URL
ENV NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=$NEXT_PUBLIC_NOTIFICATION_SERVICE_URL
ENV NEXT_PUBLIC_OPMS_URL=$NEXT_PUBLIC_OPMS_URL
ENV NEXT_PUBLIC_USER_MANAGER_URL=$NEXT_PUBLIC_USER_MANAGER_URL
ENV NEXT_PUBLIC_WORK_PLANNER_URL=$NEXT_PUBLIC_WORK_PLANNER_URL
ENV NEXT_PUBLIC_LEAD_MANAGER_URL=$NEXT_PUBLIC_LEAD_MANAGER_URL

COPY package.json ./
RUN npm install --omit=dev

COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.ts ./next.config.ts

EXPOSE 3000

CMD ["npm", "run", "start"]
